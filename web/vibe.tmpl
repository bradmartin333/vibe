    fb_ar   :  1.77,
    fb_width : "{{cookiecutter.width}}",
    fb_height : "{{cookiecutter.height}}"
}

// read by meditation/web.py: set when the canvas needs re-sizing
window.vibe_resized = true
window.addEventListener("resize", () => { window.vibe_resized = true })

// a pixel ratio change (browser zoom, moving to another monitor) is not
// always a resize, so watch the current ratio and re-arm on every change
function watch_pixel_ratio() {
    matchMedia(`(resolution: ${window.devicePixelRatio}dppx)`).addEventListener(
        "change",
        () => {
            window.vibe_resized = true
            watch_pixel_ratio()
        },
        { once: true },
    )
}
watch_pixel_ratio()

// read by meditation/web.py: last mouse or touch press in CSS pixels, which
// are the game's world units (the canvas fills the viewport from 0,0)
window.vibe_pointer_x = 0
window.vibe_pointer_y = 0
window.addEventListener(
    "pointerdown",
    (event) => {
        window.vibe_pointer_x = event.clientX
        window.vibe_pointer_y = event.clientY
    },
    { capture: true },
)

</script>

    <title>{{cookiecutter.title}}</title>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes"/>


    <link rel="icon" type="image/png" href="favicon.png">

    <style>
        /* palette matches meditation/colors.py: grey(6) background, grey(190) text */
        :root {
            --bg: #060606;
            --text: #bebebe;
            --dim: #5a5a5a;
        }

        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: var(--bg);
            color: var(--text);
            font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
        }

        #transfer {
            position: fixed;
            left: 50%;
            top: 60%;
            transform: translateX(-50%);
            z-index: 6;
        }

        #status {
            display: block;
            font-size: 13px;
            letter-spacing: 0.3em;
            color: var(--dim);
            margin-bottom: 10px;
        }

        #progress {
            appearance: none;
            -webkit-appearance: none;
            width: 200px;
            height: 2px;
            border: none;
            background-color: #1a1a1a;
        }
        #progress::-webkit-progress-bar { background-color: #1a1a1a; }
        #progress::-webkit-progress-value { background-color: var(--text); }
        #progress::-moz-progress-bar { background-color: var(--text); }

        #infobox {
            position: fixed;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            white-space: nowrap;
            background: transparent;
            color: var(--text);
            font-size: 18px;
            letter-spacing: 0.5em;
            /* extra left padding balances the spacing after the last letter */
            padding: 12px 24px 12px calc(24px + 0.5em);
            z-index: 999999;
            animation: breathe 4s ease-in-out infinite;
        }

        @keyframes breathe {
            0%, 100% { opacity: 0.35; }
            50% { opacity: 1; }
        }

        /* shown on touch-only devices, above the loading text and the canvas */
        #mobile-notice {
            position: fixed;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px;
            background-color: rgba(6, 6, 6, 0.92);
            z-index: 1000000;
            transition: opacity 0.3s ease;
        }
        #mobile-notice[hidden] { display: none; }
        #mobile-notice.closing { opacity: 0; }

        #mobile-notice .panel {
            max-width: 320px;
            padding: 24px;
            border: 1px solid #464646;
            border-radius: 8px;
            background-color: #0c0c0c;
            text-align: center;
            line-height: 1.5;
        }

        #mobile-notice h2 {
            margin: 0 0 12px;
            font-size: 18px;
            font-weight: normal;
            letter-spacing: 0.3em;
        }

        #mobile-notice p {
            margin: 0 0 20px;
            font-size: 14px;
            color: #828282;
        }

        #mobile-notice button {
            font: inherit;
            font-size: 14px;
            letter-spacing: 0.1em;
            color: var(--text);
            background-color: transparent;
            border: 1px solid var(--text);
            border-radius: 4px;
            padding: 10px 20px;
            cursor: pointer;
        }
        #mobile-notice button:active { background-color: #1a1a1a; }
        #mobile-notice button:focus-visible {
            outline: 1px solid var(--dim);
            outline-offset: 3px;
        }

        div.emscripten { text-align: center; }

        /* the canvas *must not* have any border or padding, or mouse coords will be wrong */
        canvas.emscripten {
            position: fixed;
            inset: 0;
            /* match window.innerWidth/innerHeight, which size the canvas buffer
               (100vh is taller than innerHeight on mobile with toolbars) */
            width: 100% !important;
            height: 100% !important;
            border: 0 none;
            padding: 0;
            margin: 0;
            background-color: var(--bg);
            outline: none;
            z-index: 5;
        }
    </style>

    <script src="{{cookiecutter.cdn}}/browserfs.min.js"></script>

</head>

<body>

    <div id="transfer" align=center>
        <div class="emscripten" id="status">loading</div>
        <div class="emscripten">
            <progress value="0" max="100" id="progress"></progress>
        </div>
    </div>



    <canvas class="emscripten" id="canvas"
width="1px"
height="1px"
    oncontextmenu="event.preventDefault()" tabindex=1>
    </canvas>

    <!-- unused, but pygbag adds a visible one if this is missing -->
    <canvas class="emscripten" id="canvas3d"
width="{{cookiecutter.width}}px"
height="{{cookiecutter.height}}px"
    oncontextmenu="event.preventDefault()" tabindex=1 hidden>
    </canvas>

    <div id="infobox">v i b e</div>

    <div id="mobile-notice" role="alertdialog" aria-modal="true"
        aria-labelledby="mobile-notice-title" aria-describedby="mobile-notice-text" hidden>
        <div class="panel">
            <h2 id="mobile-notice-title">best on desktop</h2>
            <p id="mobile-notice-text">
                vibe is designed to be run on a desktop with a keyboard.
                on this device you can tap fish and whales, but you can't
                move or trigger effects.
            </p>
            <button id="mobile-notice-ok" type="button">continue anyway</button>
        </div>
    </div>

    <div id=html></div>

    <div id="pyconsole">
        <div id="terminal" tabIndex=1 align="left"></div>
    </div>

    <script type="application/javascript">

    function custom_onload(debug_hidden) {
        // called by pygbag before any python is loaded
        pyconsole.hidden = debug_hidden
        transfer.hidden = debug_hidden
    }

    // touch-only devices (phones, tablets) have no keyboard for the controls,
    // so warn once on load; the game keeps loading behind the notice
    if (matchMedia("(hover: none) and (pointer: coarse)").matches) {
        const notice = document.getElementById("mobile-notice")
        const ok = document.getElementById("mobile-notice-ok")
        notice.hidden = false
        ok.focus()
        ok.addEventListener("click", () => {
            notice.classList.add("closing")
            setTimeout(() => { notice.hidden = true }, 300)
        })
    }

    </script>

</body>
</html>
